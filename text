def data_increas(path):
    imagelist= []
    
    for f in os.listdir(path):
        imagelist.append(f)
    
    image_count = len(imagelist)
    
    count = 0
    while image_count<=7000:
        img_path = os.path.join(path, imagelist[count % len(imagelist)])
        image = cv2.imread(img_path)
        
        if image_count % 6 == 0:
            img = cv2.flip(image, 1)
        elif image_count % 5 == 0:
            img = cv2.rotate(image, cv2.ROTATE_90_CLOCKWISE)
        elif image_count % 4 == 0:
            img = cv2.convertScaleAbs(image, alpha=1.2, beta=30)  
        elif image_count % 3 == 0:
            gamma = 1.5
            lookUpTable = np.array([((i / 255.0) ** gamma) * 255
                for i in np.arange(0, 256)]).astype("uint8")
            img = cv2.LUT(image, lookUpTable)
        elif image_count % 2 == 0:
            img = cv2.GaussianBlur(image, (5, 5), 0)
        else:
            hsv = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)
            mask = cv2.inRange(hsv, (0,0,0), (180,255,50))
            hsv[mask > 0] = (10,150,200)
            img = cv2.cvtColor(hsv, cv2.COLOR_HSV2BGR)
            
        img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
        image_name = os.path.join(path, f"copyfile_{image_count}.jpg")
        cv2.imwrite(image_name, img_rgb)
        image_count+=1
        count+=1

def augment_image(image, operations):
    img = image.copy()
    for op in operations:
        if op == "flip":
            img = cv2.flip(img, 1)
        elif op == "rotate":
            img = cv2.rotate(img, cv2.ROTATE_90_CLOCKWISE)
        elif op == "brightness":
            img = cv2.convertScaleAbs(img, alpha=1.2, beta=30)
        elif op == "gamma":
            gamma = 1.5
            lookUpTable = np.array([((i / 255.0) ** gamma) * 255 for i in range(256)], dtype=np.uint8)
            img = cv2.LUT(img, lookUpTable)
        elif op == "blur":
            img = cv2.GaussianBlur(img, (5,5), 0)
        elif op == "skin":
            hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)
            mask = cv2.inRange(hsv, (0,0,0), (180,255,50))
            hsv[mask>0] = (10,150,200)
            img = cv2.cvtColor(hsv, cv2.COLOR_HSV2BGR)
    return img

def generate_unique_variants(image):
    operations = ["flip","rotate","brightness","gamma","blur","skin"]
    variants = []
    
    for r in range(1, len(operations)+1):
        combos = list(itertools.combinations(operations, r))
        for ops in combos:
            variants.append(augment_image(image, ops))
    
    return variants  

if __name__ =="__main__":
    generate_unique_variants()
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
🔹 1. OpenMax’ın Mantığı

CNN modelin son fully connected katmanından çıkan aktivasyon vektörlerini (logit değil, özellik uzayı) alırsın.

Bu aktivasyonların her sınıf için ortalama vektörünü (Mean Activation Vector - MAV) hesaplıyorsun.

Yeni gelen örneğin aktivasyonu ile bu MAV’ler arasındaki mesafeyi ölçüyorsun (genelde Euclidean veya cosine).

Sonra bu mesafeleri Extreme Value Theory (EVT) ile modelleyip, skorları yeniden ölçeklendiriyorsun.

Sonuç: Eğer örnek çok uzaksa “unknown” sınıfına atanıyor.

🔹 2. DermaLens’e Entegrasyon Adımları

Senin CNN (örneğin ResNet, EfficientNet veya kendi modelin) için şunu yapacaksın:

Son katmandan önceki aktivasyonları al

from tensorflow.keras.models import Model

base_model = ...  # senin eğittiğin CNN modeli
feature_model = Model(inputs=base_model.input, 
                      outputs=base_model.layers[-2].output)  # son dense'den önceki katman


Her sınıf için MAV hesapla
Eğitim setinde her sınıf için aktivasyonları çıkar → ortalama al.

import numpy as np

def compute_mavs(feature_model, X_train, y_train):
    mavs = {}
    for cls in np.unique(y_train):
        cls_features = feature_model.predict(X_train[y_train == cls])
        mavs[cls] = np.mean(cls_features, axis=0)
    return mavs


OpenMax mesafe hesaplama + EVT uygula
Bunun için genelde libMR kütüphanesi kullanılıyor.

pip install libmr

Her sınıfın mesafe dağılımını fit et.

import libmr

def fit_weibull(mavs, feature_model, X_train, y_train, tailsize=20):
    weibull_models = {}
    for cls in mavs:
        cls_features = feature_model.predict(X_train[y_train == cls])
        distances = np.linalg.norm(cls_features - mavs[cls], axis=1)
        mr = libmr.MR()
        mr.fit_high(distances, tailsize)  # EVT fitting
        weibull_models[cls] = (mavs[cls], mr)
    return weibull_models


Tahmin aşamasında OpenMax uygula

Yeni görüntü için feature çıkar.

Her sınıfa mesafe bul.

Weibull modeli ile bu uzaklığı “olabilirlik” skoruna dönüştür.

Softmax skorlarını yeniden ölçekle.

def openmax_predict(feature_model, weibull_models, x, alpha=10):
    feat = feature_model.predict(np.expand_dims(x, 0))[0]
    scores = {}
    unknown_score = 0
    
    for cls, (mav, mr) in weibull_models.items():
        dist = np.linalg.norm(feat - mav)
        wscore = mr.w_score(dist)  # EVT olasılığı
        scores[cls] = 1 - wscore
        unknown_score += wscore
    
    # normalize
    total = sum(scores.values()) + unknown_score
    for cls in scores:
        scores[cls] /= total
    unknown_score /= total
    
    scores["unknown"] = unknown_score
    return scores

